{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "disabled_agents": [],
  "autoUpdate": false,
  "preset": "default",
  "presets": {
    "default": {
      "orchestrator": {
        "model": "opencode-go/glm-5.2",
        "variant": "max",
        "skills": ["*"],
        "mcps": ["*", "!context7"]
      },
      "oracle": {
        "model": "opencode-go/qwen3.7-max",
        "variant": "max",
        "skills": ["simplify"]
      },
      "librarian": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
        "mcps": ["websearch", "context7", "gh_grep"]
      },
      "explorer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max"
      },
      "designer": {
        "model": "opencode-go/kimi-k3",
        "variant": "high"
      },
      "fixer": {
        "model": "opencode-go/glm-5.2",
        "variant": "high"
      },
      "observer": {
        "model": "opencode-go/mimo-v2.5",
        "variant": "max"
      }
    }
  },
  "todoContinuation": {
    "autoEnable": true,
    "autoEnableThreshold": 4,
    "maxContinuations": 50,
    "cooldownMs": 3000
  }
}
