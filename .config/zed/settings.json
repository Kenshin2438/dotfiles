{
  "agent_servers": {
    "Kimi Code CLI": {
      "default_config_options": {
        "mode": "yolo"
      },
      "type": "custom",
      "command": "kimi",
      "args": ["acp"],
      "env": {},
    },
  },
  "icon_theme": "Material Icon Theme",
  "proxy": "http://127.0.0.1:7890",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Mirage",
  },
  "base_keymap": "VSCode",
  "autosave": "on_focus_change",
  "show_whitespaces": "all",
  "tab_size": 2,
  "ui_font_family": "FiraPlexCode Nerd Font",
  "ui_font_size": 14,
  "ui_font_fallbacks": ["霞鹜文楷", "LXGW WenKai"],
  "buffer_font_family": "FiraPlexCode Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_fallbacks": ["霞鹜文楷", "LXGW WenKai"],
}
