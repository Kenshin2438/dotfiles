{
  "ssh_connections": [
    {
      "host": "mac-mini-m4",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/kenshin/dotfiles"
          ]
        },
        {
          "paths": [
            "/Users/kenshin/repos/Resume"
          ]
        }
      ]
    }
  ],
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "Kimi Code CLI": {
      "default_config_options": {
        "mode": "yolo",
      },
      "type": "custom",
      "command": "kimi",
      "args": ["acp"],
      "env": {},
    },
  },
  "icon_theme": "Material Icon Theme",
  "proxy": "http://localhost:7890",
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "base_keymap": "VSCode",
  "autosave": "on_focus_change",
  "show_whitespaces": "all",
  "tab_size": 2,
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 14,
  "ui_font_fallbacks": ["霞鹜文楷", "LXGW WenKai"],
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_fallbacks": ["霞鹜文楷", "LXGW WenKai"],
}
